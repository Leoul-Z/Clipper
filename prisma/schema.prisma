generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClipperStatus {
  PENDING_HANDLES
  AWAITING_ADMIN
  CODES_ISSUED
  AWAITING_BIO_APPROVAL
  PENDING_PAYMENT
  ACTIVE_CLIPPER
  REJECTED
}

model User {
  id              String        @id @default(uuid())
  telegramId      BigInt        @unique
  username        String
  campaign        String?
  youtubeHandle   String?
  instagramHandle String?
  tiktokHandle    String?
  ytCode          String?
  igCode          String?
  ttCode          String?
  bankName        String?
  accountNumber   String?
  status          ClipperStatus @default(PENDING_HANDLES)
  views           Int           @default(0)
  videos          Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Session {
  id    String @id
  value String
}
